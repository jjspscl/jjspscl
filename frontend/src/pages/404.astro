---
import { Button } from "@components/Button";
import BaseLayout from "@components/layouts/base.astro";

export const prerender = true;

const language = Astro.url.searchParams.get("lang");
const message = language === "en-ph" ? "Wala dito hinahanap mo" : "Page not found";
---

<BaseLayout title="Page Not Found" robots="noindex, follow" canonical="">
    <div class="ds-container my-auto grid items-center">
        <section class="py-16 text-center">
            <h1 class="text-heading-1 mb-4 font-bold">404</h1>
            <p class="mb-8 text-body-lg text-ink-muted">{message}</p>
            <Button as="a" href="/" variant="outline">Go home</Button>
        </section>
    </div>
</BaseLayout>
