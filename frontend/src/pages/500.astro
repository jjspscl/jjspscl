---
import { Button } from "@components/Button";
import BaseLayout from "@components/layouts/base.astro";

export const prerender = false;
---

<BaseLayout title="Service Unavailable" robots="noindex, follow" canonical="">
    <div class="ds-container grid min-h-[60vh] items-center">
        <section class="py-16 text-center">
            <h1 class="text-heading-1 mb-4 font-bold">Temporarily unavailable</h1>
            <p class="mb-8 text-body-lg text-ink-muted">Please try again later.</p>
            <Button as="a" href="/" variant="outline">Go home</Button>
        </section>
    </div>
</BaseLayout>
