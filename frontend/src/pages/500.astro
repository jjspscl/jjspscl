---
import BaseLayout from "@components/layouts/base.astro";

export const prerender = false;
---

<BaseLayout title="Service Unavailable" robots="noindex, follow" canonical="">
    <div class="grid min-h-[60vh] items-center container mx-auto max-w-screen-md px-4">
        <section class="py-16 text-center">
            <h1 class="mb-4 text-4xl font-bold md:text-5xl">Temporarily unavailable</h1>
            <p class="mb-8 text-lg text-text-secondary">Please try again later.</p>
            <a href="/" class="inline-flex min-h-11 items-center justify-center rounded-xl border-4 border-vhs-black px-6 py-2.5 font-bold vhs-shadow transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:border-vhs-cream">Go home</a>
        </section>
    </div>
</BaseLayout>
