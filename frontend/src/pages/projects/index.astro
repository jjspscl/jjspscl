---
export const prerender = true;

import BaseLayout from "@components/layouts/base.astro";
import ProjectCard from "@features/projects/components/ProjectCard.astro";
import { getProjects } from "@features/projects/project.service";

import type { IProjectRecord } from "@features/projects/project.type";

let projects: IProjectRecord[] = [];
try {
    const result = await getProjects();
    if (!result.ok) {
        if (result.error.code === "not_found") {
            Astro.response.status = 404;
            return Astro.rewrite("/404");
        }
        Astro.response.status = 503;
        return Astro.rewrite("/500");
    }
    projects = result.projects;
} catch (error: unknown) {
    console.error("Unexpected project list failure", error);
    Astro.response.status = 503;
    return Astro.rewrite("/500");
}
---

<BaseLayout title="Projects" description="Explore software projects and side projects built by Joshua Pascual, showcasing web development and engineering skills.">
    <div class="container mx-auto max-w-screen-md px-4">
        <h1 class="mb-8 text-4xl font-bold">Projects</h1>
        <section class="grid gap-4 mb-10">
            {projects.length > 0 ? (
                projects.map((project) => <ProjectCard project={project.card} slug={project.story.slug}/>)
            ) : (
                <div class="text-center py-16">
                    <svg class="w-12 h-12 mx-auto mb-4 text-text-secondary/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                    </svg>
                    <p class="text-text-secondary">No projects found.</p>
                </div>
            )}
        </section>
    </div>
</BaseLayout>
