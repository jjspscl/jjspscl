---
export const prerender = true;

import Badge from "@components/Badge.astro";
import Base from "@components/layouts/base.astro";
import { getAllTags } from "@features/blog/blog.service";

let allTags: Awaited<ReturnType<typeof getAllTags>> = [];

try {
    allTags = await getAllTags();
} catch (error: unknown) {
    if (typeof error === "object" && error !== null && "status" in error && (error as { status: number }).status === 404) {
        Astro.response.status = 404;
        return Astro.rewrite("/404");
    }
    Astro.response.status = 503;
    return Astro.rewrite("/500");
}

const title = "Blog Tags";
const description = "Browse all article tags";
---

<Base title={title} description={description}>
    <div class="ds-container">
        <h1 class="text-heading-1 mb-8 font-bold">{title}</h1>
        {allTags.length > 0 ? (
            <section aria-label="Article tags" class="flex flex-wrap gap-3">
                {allTags.map((tagStory) => {
                    const tag = tagStory.content;
                    const href = `/blog?tags=${encodeURIComponent(tag.title)}`;
                    return (
                        <Badge
                            label={tag.title}
                            href={href}
                            size="md"
                            icon={tag.icon?.filename ? { src: tag.icon.filename } : undefined}
                        />
                    );
                })}
            </section>
        ) : (
            <div class="py-16 text-center">
                <svg class="mx-auto mb-4 h-12 w-12 text-ink-muted/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
                    <line x1="7" y1="7" x2="7.01" y2="7" />
                </svg>
                <p class="mb-4 text-ink-muted">No tags found.</p>
                <a href="/blog" class="inline-flex min-h-11 items-center text-action hover:underline text-sm font-medium">
                    Browse articles
                </a>
            </div>
        )}
    </div>
</Base>
