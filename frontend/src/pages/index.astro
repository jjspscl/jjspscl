---
import MyImage from "@components/assets/Me.astro";
import { Button } from "@components/Button";
import Footer from "@components/Footer.astro";
import Root from "@components/layouts/root.astro";
import ProjectCard from "@features/projects/components/ProjectCard.astro";
import { getProjects } from "@features/projects/project.service";
import { AUTHOR } from "@features/seo/seo.constant";
import { links } from "@lib/constants/links";
import { TRANSITION_NAMES } from "@lib/constants/transition";

import type { IProjectRecord } from "@features/projects/project.type";

export const prerender = true;

let projects: IProjectRecord[] = [];
try {
    const result = await getProjects();
    if (!result.ok) {
        throw new Error(result.error.code);
    }
    projects = result.projects.slice(0, 4);
} catch (error: unknown) {
    console.error("Unexpected homepage project failure", error);
    Astro.response.status = 503;
    return Astro.rewrite("/500");
}
---

<Root schemaType="home">
    <main class="flex flex-1 flex-col" id="main-content">
        <section class="ds-container flex min-h-[80vh] flex-col items-center justify-center">
            <div class="flex flex-col items-center sm:flex-row" data-animate="fade-up">
                <span class="mb-10 sm:mb-0" transition:name={TRANSITION_NAMES.MY_IMAGE}>
                    <a aria-label="About me" class="flex items-center" href="/about">
                        <MyImage />
                    </a>
                </span>
                <div class="text-center md:ml-10 md:text-left">
                    <a aria-label="About me" class="flex items-center" href="/about">
                        <h1 class="text-display-xl font-bold highlight-text">
                            i'm <br />joshua
                        </h1>
                    </a>
                    <p class="text-body-lg mt-4 font-medium text-ink-muted" data-animate="fade-up" data-delay="200">
                        {AUTHOR.jobTitle}
                    </p>
                </div>
            </div>
        </section>

        {projects.length > 0 && (
            <section class="ds-container-wide py-section">
                <div class="mb-8 flex items-baseline justify-between gap-4" data-animate="fade-up">
                    <h2 class="text-heading-2 font-bold">projects</h2>
                    <a href="/projects" class="inline-flex min-h-11 items-center text-sm font-medium text-ink-muted hover:text-ink" data-astro-prefetch>
                        view all &rarr;
                    </a>
                </div>
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                    {projects.map((project, index) => (
                        <div data-animate="fade-up" data-delay={String(index * 100)}>
                            <ProjectCard project={project.card} slug={project.story.slug} headingLevel={3} />
                        </div>
                    ))}
                </div>
            </section>
        )}

        <section class="ds-container py-section">
            <div class="text-center" data-animate="fade-up">
                <h2 class="text-heading-2 mb-4 font-bold">let's connect</h2>
                <p class="text-body-lg mx-auto mb-8 max-w-md text-ink-muted">
                    Have a project in mind or just want to say hello? I'd love to hear from you.
                </p>
                <Button as="a" href="/contact" variant="outline" size="lg" data-astro-prefetch>
                    get in touch
                </Button>
            </div>
        </section>

        <section class="ds-container pb-4 pt-8">
            <nav aria-label="Page navigation" class="flex flex-wrap justify-center gap-x-8 gap-y-2" data-animate="fade-in">
                {links.map(({ href, text }) => (
                    <a class="inline-flex min-h-11 items-center text-xl font-bold text-ink-muted hover:text-action md:text-2xl" data-astro-prefetch href={href}>
                        {text}
                    </a>
                ))}
            </nav>
        </section>
    </main>

    <Footer />
</Root>
