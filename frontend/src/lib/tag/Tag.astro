---
import Badge from "@components/Badge.astro";

import type { ITag } from "./tag.type";

interface Props {
    tag?: ITag;
    blok?: ITag;
    href?: string;
    active?: boolean;
    colorful?: boolean;
    external?: boolean;
}

const { tag, blok, href, active = false, colorful = false, external = Boolean(href) } = Astro.props;
const data = tag || blok;
---

{data && (
    <Badge
        label={data.title}
        href={href}
        external={external}
        current={active}
        tone={colorful ? "accent" : "neutral"}
        icon={data.icon?.filename ? { src: data.icon.filename } : undefined}
    />
)}
