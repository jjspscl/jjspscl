---
import Badge from "@components/Badge.astro";
import { storyblokEditable } from "@storyblok/astro";

import type { IArticleTag } from "../blog.type";

interface Props {
    tag?: IArticleTag;
    blok?: IArticleTag;
    href?: string;
    active?: boolean;
    colorful?: boolean;
}

const { tag, blok, href, active = false, colorful = false } = Astro.props;
const data = tag || blok;
---

{data && (
    <Badge
        label={data.title}
        href={href}
        current={active}
        tone={colorful ? "accent" : "neutral"}
        icon={data.icon?.filename ? { src: data.icon.filename } : undefined}
        editable={storyblokEditable(data)}
    />
)}
