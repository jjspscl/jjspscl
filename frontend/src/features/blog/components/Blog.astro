---
import Prose from "@components/Prose.astro";
import { storyblokEditable, renderRichText } from "@storyblok/astro";

import ArticleTag from "./ArticleTag.astro";

import type { IArticleBlok } from "../blog.type";

interface Props {
  blok: IArticleBlok;
  slug: string;
}

const { blok, slug } = Astro.props;
const renderedRichText = renderRichText(blok.content)?.replace(/<h1(\s[^>]*)?>/gi, "<h2$1>").replace(/<\/h1>/gi, "</h2>") ?? "";
const tags = blok.tags || [];
---

<article {...storyblokEditable(blok)} class="mb-28 text-ink">
    <div class="mb-12">
        <h1 class="text-heading-1 mt-12 mb-4 font-bold" transition:name={slug}>
            {blok.title}
        </h1>
        {blok.created_at && <time class="mb-4 block text-base text-ink-muted" datetime={blok.created_at}>{blok.created_at}</time>}
        {tags.length > 0 && (
            <div class="mb-6 flex flex-wrap gap-2">
                {tags.map((tag) => (
                    <ArticleTag
                        tag={tag.content}
                        href={`/blog?tags=${encodeURIComponent(tag.content.title)}`}
                        colorful
                    />
                ))}
            </div>
        )}
        {blok.subtitle && <h2 class="text-heading-3 mb-6 font-semibold">{blok.subtitle}</h2>}
        <Prose size="large">
            <Fragment set:html={renderedRichText} />
        </Prose>
    </div>
</article>
