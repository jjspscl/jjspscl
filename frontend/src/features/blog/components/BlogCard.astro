---
import { Card } from "@components/Card";

import ArticleTag from "./ArticleTag.astro";

import type { IBlog } from "@features/blog/blog.type";

interface Props {
    slug: string;
    blog: IBlog;
}

const { blog, slug } = Astro.props;
const href = `/blog/${slug}`;
const tags = blog.tags || [];
---
<Card className="grid gap-4">
        <h2 class="text-heading-3 font-bold"><a href={href} data-astro-prefetch class="hover:text-action">{blog.title}</a></h2>
        {blog.headline && <p class="text-base text-ink-muted">{blog.headline}</p>}
        {tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                    <ArticleTag 
                        tag={tag.content} 
                        href={`/blog?tags=${encodeURIComponent(tag.content.title)}`}
                        colorful 
                    />
                ))}
            </div>
        )}
</Card>
