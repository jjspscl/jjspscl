---
import Badge from "@components/Badge.astro";
import { Card } from "@components/Card";
import MediaFrame from "@components/MediaFrame.astro";
import Prose from "@components/Prose.astro";
import TextLink from "@components/TextLink.astro";
import { storyblokEditable } from "@storyblok/astro";
import { renderRichText } from "@storyblok/js";

import type { IProjectRecord } from "../project.type";

interface Props {
    project: IProjectRecord;
}

const { project } = Astro.props;
const { detail, story } = project;

const renderDocument = (document: Parameters<typeof renderRichText>[0] | undefined, headingLevel = 2): string => {
    if (!document) {
        return "";
    }

    try {
        return renderRichText(document)
            .replace(/<h[1-6]\b/gi, `<h${headingLevel}`)
            .replace(/<\/h[1-6]>/gi, `</h${headingLevel}>`);
    } catch (error: unknown) {
        console.error("Failed to render project rich text", { slug: story.full_slug, error });
        return "";
    }
};

const coverFilename = detail.cover?.image?.filename;
const coverAlt = detail.cover?.altText || detail.cover?.image?.alt || detail.title;
---

<article {...storyblokEditable(story.content)} class="grid gap-10">
    <header class="grid gap-4">
        <p class="font-meta text-meta font-medium uppercase tracking-widest text-ink-muted">Project</p>
        <h1 class="text-heading-1 break-words font-bold">{detail.title}</h1>
        {detail.headline && <p class="text-body-lg max-w-2xl text-ink-muted">{detail.headline}</p>}
        <nav aria-label="Project navigation" class="flex flex-wrap gap-2">
            <TextLink href="/projects" variant="standalone">Back to projects</TextLink>
            {(detail.demo?.url || detail.demo?.cachedUrl) && <TextLink href={detail.demo?.url || detail.demo?.cachedUrl || ""} variant="standalone" external ariaLabel={`View demo for ${detail.title} (opens in a new tab)`}>View demo</TextLink>}
            {(detail.repository?.url || detail.repository?.cachedUrl) && <TextLink href={detail.repository?.url || detail.repository?.cachedUrl || ""} variant="standalone" external ariaLabel={`View repository for ${detail.title} (opens in a new tab)`}>View repository</TextLink>}
        </nav>
    </header>

    {coverFilename && <MediaFrame src={coverFilename} alt={coverAlt} width={detail.cover?.image?.dimensions?.width} height={detail.cover?.image?.dimensions?.height} loading="eager" fetchpriority="high" />}

    {detail.technology.length > 0 && (
        <section aria-labelledby="project-technologies" class="grid gap-3">
            <h2 id="project-technologies" class="text-heading-2 font-bold">Technologies</h2>
            <ul class="flex flex-wrap gap-2">
                {detail.technology.map((technology) => <li><Badge label={technology.name} /></li>)}
            </ul>
        </section>
    )}

    {detail.metadata.role || detail.metadata.team || detail.metadata.scope.length > 0 ? (
        <Card variant="outlined" className="grid gap-4">
            <h2 id="project-metadata" class="text-heading-2 font-bold">Role and scope</h2>
            <dl class="grid gap-3 sm:grid-cols-2">
                {detail.metadata.role && <div><dt class="font-semibold">Role</dt><dd class="text-ink-muted">{detail.metadata.role}</dd></div>}
                {detail.metadata.team && <div><dt class="font-semibold">Team</dt><dd class="text-ink-muted">{detail.metadata.team}</dd></div>}
                {detail.metadata.scope.length > 0 && <div class="sm:col-span-2"><dt class="font-semibold">Scope</dt><dd class="text-ink-muted">{detail.metadata.scope.join(", ")}</dd></div>}
            </dl>
        </Card>
    ) : null}

    {detail.narrativeSections.map((section) => {
        const body = renderDocument(section.body);
        return (
            <section {...storyblokEditable({ _editable: section.editable })} class="grid gap-4">
                {section.heading && <h2 class="text-heading-2 font-bold">{section.heading}</h2>}
                {body && <Prose><Fragment set:html={body} /></Prose>}
                {section.media?.image?.filename && <MediaFrame src={section.media.image.filename} alt={section.media.altText || section.media.image.alt || section.heading || detail.title} width={section.media.image.dimensions?.width} height={section.media.image.dimensions?.height} caption={section.media.caption} />}
            </section>
        );
    })}

    {detail.gallery.length > 0 && (
        <section aria-labelledby="project-gallery" class="grid gap-6">
            <h2 id="project-gallery" class="text-heading-2 font-bold">Gallery</h2>
            {detail.gallery.map((media) => media.mediaType === "video" && (media.videoUrl?.url || media.videoUrl?.cachedUrl) ? (
                <div class="grid gap-2">
                    {media.posterImage?.filename && <MediaFrame src={media.posterImage.filename} alt={media.altText || media.posterImage.alt || detail.title} width={media.posterImage.dimensions?.width} height={media.posterImage.dimensions?.height} caption={media.caption} />}
                    <TextLink href={media.videoUrl.url || media.videoUrl.cachedUrl || ""} variant="standalone" external ariaLabel={`Open project video for ${detail.title} (opens in a new tab)`}>Open video</TextLink>
                </div>
            ) : media.image?.filename ? (
                <MediaFrame src={media.image.filename} alt={media.altText || media.image.alt || detail.title} width={media.image.dimensions?.width} height={media.image.dimensions?.height} caption={media.caption} />
            ) : null)}
        </section>
    )}

    {detail.decisions.length > 0 && (
        <section aria-labelledby="project-decisions" class="grid gap-6">
            <h2 id="project-decisions" class="text-heading-2 font-bold">Decisions</h2>
            {detail.decisions.map((decision, index) => (
                <Card variant="outlined" className="grid gap-4">
                    <h3 class="text-heading-3 font-bold">{decision.title || `Decision ${index + 1}`}</h3>
                    {decision.context && <div class="grid gap-2"><h4 class="font-meta text-meta font-semibold uppercase tracking-widest text-ink-muted">Context</h4><Prose><Fragment set:html={renderDocument(decision.context, 4)} /></Prose></div>}
                    {decision.decision && <div class="grid gap-2"><h4 class="font-meta text-meta font-semibold uppercase tracking-widest text-ink-muted">Decision</h4><Prose><Fragment set:html={renderDocument(decision.decision, 4)} /></Prose></div>}
                    {decision.rationale && <div class="grid gap-2"><h4 class="font-meta text-meta font-semibold uppercase tracking-widest text-ink-muted">Rationale</h4><Prose><Fragment set:html={renderDocument(decision.rationale, 4)} /></Prose></div>}
                    {decision.tradeoffs && <div class="grid gap-2"><h4 class="font-meta text-meta font-semibold uppercase tracking-widest text-ink-muted">Tradeoffs</h4><Prose><Fragment set:html={renderDocument(decision.tradeoffs, 4)} /></Prose></div>}
                </Card>
            ))}
        </section>
    )}

    {detail.outcomes.length > 0 && (
        <section aria-labelledby="project-outcomes" class="grid gap-6">
            <h2 id="project-outcomes" class="text-heading-2 font-bold">Outcomes</h2>
            {detail.outcomes.map((outcome, index) => (
                <Card variant="outlined" className="grid gap-4">
                    <h3 class="text-heading-3 font-bold">{outcome.title || `Outcome ${index + 1}`}</h3>
                    {outcome.summary && <Prose><Fragment set:html={renderDocument(outcome.summary, 4)} /></Prose>}
                    {outcome.metrics.length > 0 && <dl class="grid gap-3 sm:grid-cols-2">{outcome.metrics.map((metric) => <div>{metric.label && <dt class="font-semibold">{metric.label}</dt>}{metric.value && <dd class="text-ink-muted">{metric.value}{metric.context && ` — ${metric.context}`}{(metric.source?.url || metric.source?.cachedUrl) && <TextLink href={metric.source.url || metric.source.cachedUrl || ""} external class="ml-2">Source</TextLink>}</dd>}</div>)}</dl>}
                </Card>
            ))}
        </section>
    )}

    {(detail.navigation?.previous || detail.navigation?.next) && (
        <nav aria-label="Adjacent projects" class="flex flex-wrap justify-between gap-4 border-t border-border pt-6">
            {detail.navigation.previous ? <TextLink href={`/projects/${detail.navigation.previous.slug}`} variant="standalone">← {detail.navigation.previous.title}</TextLink> : <span />}
            {detail.navigation.next && <TextLink href={`/projects/${detail.navigation.next.slug}`} variant="standalone">{detail.navigation.next.title} →</TextLink>}
        </nav>
    )}
</article>
