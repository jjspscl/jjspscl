---
import { Card } from "@components/Card";
import TextLink from "@components/TextLink.astro";
import Tag from "@lib/tag/Tag.astro";

import type { IProjectCardData } from "../project.type";

interface Props {
  slug: string;
  project: IProjectCardData;
  headingLevel?: 2 | 3;
}

const { project, slug, headingLevel = 2 } = Astro.props;
const demoUrl = project.demoUrl;
const repository = project.repositoryUrl;
const technology = project.technology;
const Heading = headingLevel === 3 ? "h3" : "h2";
---

<Card className="grid gap-4">
  <div class="flex items-start justify-between gap-4">
    <Heading class="text-heading-3 min-w-0 break-words font-bold">
      <a href={`/projects/${slug}`} class="hover:text-action">{project.title}</a>
    </Heading>
    <div class="flex shrink-0 items-center gap-1">
      {repository && (
        <a class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-control text-ink-muted transition-opacity hover:opacity-70 hover:text-ink" href={repository} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} GitHub repository (opens in a new tab)`}>
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
      )}
      {demoUrl && (
        <TextLink href={demoUrl} variant="standalone" external ariaLabel={`View demo for ${project.title} (opens in a new tab)`}>Demo</TextLink>
      )}
    </div>
  </div>
  {project.headline && <p class="text-base text-ink-muted">{project.headline}</p>}
  {technology.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {technology.map((tech) => (
        <Tag
          tag={{
            _uid: tech.uuid,
            title: tech.name,
            icon: tech.logo,
            component: "tech-stack",
          }}
          href={tech.source?.cachedUrl || tech.source?.url}
          external={Boolean(tech.source?.cachedUrl || tech.source?.url)}
          colorful
        />
      ))}
    </div>
  )}
</Card>
