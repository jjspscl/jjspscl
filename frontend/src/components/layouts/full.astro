---
import RootLayout from './root.astro';
import FullHeader from '../Header/FullHeader.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedDate?: string;
  robots?: string;
  canonical?: string;
  mainClass?: string;
}

const { title, description, image, type, publishedDate, robots, canonical, mainClass = "" } = Astro.props;
---

<RootLayout title={title} description={description} image={image} type={type} publishedDate={publishedDate} robots={robots} canonical={canonical}>
    <slot name="head" slot="head" />
    <FullHeader />
    <main id="main-content" class={mainClass}>
        <slot />
    </main>
</RootLayout>
