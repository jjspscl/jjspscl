---
import TextLink from "@components/TextLink.astro";

interface Props {
    label: string;
    href: string;
    active?: boolean;
    class?: string;
}

const { label, href, active = false, class: className = "" } = Astro.props;
---

<TextLink href={href} variant="navigation" current={active ? "page" : undefined} prefetch class={className}>
    {label}
</TextLink>
