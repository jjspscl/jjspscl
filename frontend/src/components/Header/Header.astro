---
import { links } from "@lib/constants/links";

import HeaderLink from "./HeaderLink.astro";
import Logo from "../assets/Logo.astro";

const currentPath = Astro.url.pathname;
const normalizePath = (path: string) => path === "/" ? path : path.replace(/\/$/, "");
const normalizedCurrentPath = normalizePath(currentPath);
---

<header
    class="ds-container my-4 flex items-center justify-between gap-2"
>
        <a class="inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-control font-bold" href="/">
        <Logo width={36} height={36} />
    </a>
    <nav aria-label="Main navigation" class="flex flex-wrap justify-end text-sm sm:text-base md:text-xl">
        {
            links.map(({ href, text }) => (
                <HeaderLink 
                    href={href} 
                    label={text} 
                    class="px-1.5 sm:px-2"
                    active={normalizedCurrentPath === normalizePath(href) || normalizedCurrentPath.startsWith(`${normalizePath(href)}/`)}
                />
            ))
        }
    </nav>
</header>
